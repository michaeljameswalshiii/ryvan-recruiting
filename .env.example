# AWS Configuration (after CDK deploy)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx

# Server-side Cognito (prefer non-public when possible)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# AWS_REGION=us-east-1

# DynamoDB Tables
NEXT_PUBLIC_TENANTS_TABLE=turnkey-tenants
NEXT_PUBLIC_PROFILES_TABLE=turnkey-profiles
NEXT_PUBLIC_CLIENTS_TABLE=turnkey-clients
NEXT_PUBLIC_LEADS_TABLE=turnkey-leads
NEXT_PUBLIC_SOURCES_TABLE=turnkey-sources
# DYNAMODB_PROFILES_TABLE=turnkey-profiles

# AWS credentials (server-side only — never NEXT_PUBLIC_)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Third-party APIs (server-only)
# APOLLO_API_KEY=

# Required in production for encrypting user BYOK AI keys
# AI_CREDENTIALS_SECRET=generate-a-long-random-string

# Admin DynamoDB API
# ADMIN_EMAIL_ALLOWLIST=you@example.com
# ADMIN_API_DISABLED=false

# Public careers feed (external website / Squarespace)
# CAREERS_TENANT_ID=tenant-your-id
# CAREERS_PUBLIC_KEY=optional-public-site-key
# CAREERS_CORS_ORIGINS=*
# CAREERS_TENANT_SLUGS=ryvan:tenant-xxx
# NEXT_PUBLIC_APP_URL=https://turnkey-optimization.vercel.app
