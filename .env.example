# AWS Configuration (after CDK deploy)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx

# Server-side Cognito (prefer non-public when possible)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# AWS_REGION=us-east-1

# DynamoDB Tables
NEXT_PUBLIC_TENANTS_TABLE=turnkey-tenants
NEXT_PUBLIC_PROFILES_TABLE=turnkey-profiles
NEXT_PUBLIC_CLIENTS_TABLE=turnkey-clients
NEXT_PUBLIC_LEADS_TABLE=turnkey-leads
NEXT_PUBLIC_SOURCES_TABLE=turnkey-sources
# DYNAMODB_PROFILES_TABLE=turnkey-profiles

# AWS credentials (server-side only — never NEXT_PUBLIC_)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fill job LLM (Apollo plan + re-rank) — Sonnet quality; list-builder stays on Haiku
# FILL_JOB_PLAN_MODEL_ID=global.anthropic.claude-sonnet-4-6
# FILL_JOB_RERANK_MODEL_ID=global.anthropic.claude-sonnet-4-6   # defaults to plan model
# LIST_BUILDER_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# AI_MODEL=global.anthropic.claude-sonnet-4-6   # shared product default if plan env unset

# Third-party APIs (server-only)
# Apollo.io is OFF by default (code kept for easy re-enable).
# AI_TOOLS_APOLLO_ENABLED=true
# NEXT_PUBLIC_AI_TOOLS_APOLLO_ENABLED=true   # shows AI Apollo in nav
# APOLLO_API_KEY=
#
# People Data Labs — Candidate Search Agent (AWS Data Exchange or direct PDL key)
# PEOPLE_DATA_LABS_API_KEY=
# PDL_API_KEY=                    # alias accepted
# PDL_COST_PER_PERSON=0.03        # USD estimate per returned person for Usage dashboard
#
# Tavily web search (also off by default)
# AI_TOOLS_TAVILY_ENABLED=true

# Required in production for encrypting user BYOK AI keys
# AI_CREDENTIALS_SECRET=generate-a-long-random-string

# Admin DynamoDB API
# ADMIN_EMAIL_ALLOWLIST=you@example.com
# ADMIN_API_DISABLED=false

# Public careers feed (multi-tenant)
# CAREERS_TENANT_ID=tenant-your-id          # preferred when slug is ambiguous
# CAREERS_DEFAULT_SLUG=ryvan                # /careers redirects here
# NEXT_PUBLIC_CAREERS_DEFAULT_SLUG=ryvan    # ATS "View public page" link
# CAREERS_TENANT_SLUGS=ryvan:tenant-xxx,acme:tenant-yyy
# CAREERS_PUBLIC_KEY=optional-public-site-key
# CAREERS_CORS_ORIGINS=*
# NEXT_PUBLIC_APP_URL=https://turnkey-optimization.vercel.app
# CAREERS_SHOW_COMPANY_NAME=false
#   default: hide client company label on public pages (agency mode)

