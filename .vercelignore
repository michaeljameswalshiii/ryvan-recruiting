# Local ops — never ship to Vercel build context
scripts/
cdk/
mcp-server/

# Documentation (not needed at runtime)
*.md
!.gitignore

# Local config / dumps
*.log
.env
.env.*
!.env.example
*.pem
*.key
client-config.json
clients-*.json
lead-*.json
tmp-*.json
body.txt
bedrock-body.b64

# Tests
**/*.test.ts
**/*.spec.ts
**/__tests__/
coverage/

# Local Next cache
.next/

# Throwaway root artifacts if recreated
commit*.bat
commit*.ps1
deploy-temp.bat
VERCEL_FORCE_REDEPLOY.txt
temp_*
test-*.js
check-*.js
